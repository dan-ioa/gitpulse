# LLM provider switch: "google" for Google AI Studio, "local" for LM Studio
LLM_PROVIDER=google

# --- Google AI Studio (Gemini) ---
# Get your key at https://aistudio.google.com/apikey
# Model format: gemini/<model-name>  (routed via LiteLLM)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
MODEL=gemini/gemini-2.0-flash
# Other models: gemini/gemini-2.5-pro, gemini/gemini-1.5-pro

# OpenAI-compatible shim for Google AI Studio — some tools (e.g. GithubSearchTool)
# require OPENAI_API_KEY. Setting these routes those calls to Google's endpoint instead.
OPENAI_API_KEY=your_google_ai_studio_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Local (LM Studio) ---
# Set LLM_PROVIDER=local and configure the section below.
# BASE_URL=http://127.0.0.1:1234/v1
# MODEL=google/gemma-4-e4b      # model identifier shown by `lms ps`
# LM_API_TOKEN=your_lm_studio_api_token_here   # only if auth is enabled

# GitHub Personal Access Token — enables direct GitHub repository search
# Create one at https://github.com/settings/tokens (read-only public repos scope is enough)
# Optional: the agent falls back to web search alone if this is not set.
GITHUB_TOKEN=your_github_personal_access_token_here

# Search tool used by the research agent
SERPER_API_KEY=your_serper_api_key_here

# Resend API key for HTML email delivery
# Sign up free at https://resend.com — no domain needed, emails send from onboarding@resend.dev
RESEND_API_KEY=your_resend_api_key_here

# Resend Audience ID — the digest is sent as one broadcast to everyone in this audience.
# Create an audience at https://resend.com/audiences, add yourself as a contact,
# then paste the audience ID here. Required — without it, nothing is sent.
RESEND_AUDIENCE_ID=your_resend_audience_id_here

# Sender address for the broadcast.
# Defaults to "The Git Pulse <onboarding@resend.dev>" if unset, which needs no domain setup.
# To send from your own domain, verify it at https://resend.com/domains first.
RESEND_FROM_EMAIL=The Git Pulse <onboarding@resend.dev>
